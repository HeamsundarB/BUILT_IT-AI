# =============================================================================
# BUILTIT AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=change-me-to-at-least-32-chars-in-production-!

# ---------------------------------------------------------------------------
# Public (safe to expose to browser — must start with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=BUILTIT AI
NEXT_PUBLIC_APP_TAGLINE=Upload. Analyze. Build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_AI_DISCLAIMER=AI-derived logical construction sequence — not the actual historical drawing order from the original image.

# ---------------------------------------------------------------------------
# Authentication (server-only)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=change-me-to-at-least-32-chars-in-production-!
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI Services (server-only — NEVER expose to frontend)
# Set AI_SERVICE_MOCK=false to connect real AI
# ---------------------------------------------------------------------------
AI_SERVICE_MOCK=true

# Uncomment and fill when connecting real AI:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...
# AI_MODEL=gpt-4o
# AI_VISION_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Database (server-only)
# ---------------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# ---------------------------------------------------------------------------
# File Storage (server-only)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=mock
LOCAL_UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=20

# S3 (uncomment when using AWS S3):
# STORAGE_PROVIDER=s3
# S3_BUCKET=builtit-ai-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cloudinary (uncomment when using Cloudinary):
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Voice Service (server-only)
# ---------------------------------------------------------------------------
VOICE_PROVIDER=mock
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# Video/Animation Service (server-only)
# ---------------------------------------------------------------------------
VIDEO_PROVIDER=mock

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------
EXPORT_DIR=./public/exports

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
